{
	"compilerOptions": {
		"composite": true,
		"module": "commonjs",
		"target": "es2019",
		"lib": ["ES2019"],
		"outDir": "out",
		"rootDir": "src",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.json"],
	"exclude": ["node_modules", ".vscode-test"]
}