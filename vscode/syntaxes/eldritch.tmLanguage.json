{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Eldritch",
    "scopeName": "source.eldritch",
    "fileTypes": [
        "eldritch",
        "tome"
    ],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#function-def" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#stdlib-calls" },
        { "include": "#stdlib-modules" },
        { "include": "#builtins" },
        { "include": "#method-calls" },
        { "include": "#function-calls" },
        { "include": "#keyword-arguments" },
        { "include": "#numbers" },
        { "include": "#illegal-operators" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.eldritch",
                    "begin": "#",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.comment.eldritch" }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "keyword.codetag.notation.eldritch",
                            "match": "\\b(TODO|FIXME|NOTE|HACK|XXX|BUG|WARNING|DEPRECATED)\\b"
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.interpolated.triple.double.eldritch",
                    "begin": "\\b([fF][rR]?|[rR][fF])(\"\"\")",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "\"\"\"",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.eldritch" }
                    },
                    "patterns": [
                        { "include": "#fstring-interpolation" },
                        { "include": "#string-escapes" }
                    ]
                },
                {
                    "name": "string.interpolated.triple.single.eldritch",
                    "begin": "\\b([fF][rR]?|[rR][fF])(''')",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "'''",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.eldritch" }
                    },
                    "patterns": [
                        { "include": "#fstring-interpolation" },
                        { "include": "#string-escapes" }
                    ]
                },
                {
                    "name": "string.quoted.triple.double.eldritch",
                    "begin": "(\\b(?:[bB][rR]?|[rR][bB]?)?)(\"\"\")",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "\"\"\"",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.eldritch" }
                    },
                    "patterns": [
                        { "include": "#string-escapes" }
                    ]
                },
                {
                    "name": "string.quoted.triple.single.eldritch",
                    "begin": "(\\b(?:[bB][rR]?|[rR][bB]?)?)(''')",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "'''",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.eldritch" }
                    },
                    "patterns": [
                        { "include": "#string-escapes" }
                    ]
                },
                {
                    "name": "string.interpolated.double.eldritch",
                    "begin": "\\b([fF][rR]?|[rR][fF])(\")",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "(\")|($)",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.eldritch" },
                        "2": { "name": "invalid.illegal.newline.eldritch" }
                    },
                    "patterns": [
                        { "include": "#fstring-interpolation" },
                        { "include": "#string-escapes" }
                    ]
                },
                {
                    "name": "string.interpolated.single.eldritch",
                    "begin": "\\b([fF][rR]?|[rR][fF])(')",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "(')|($)",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.eldritch" },
                        "2": { "name": "invalid.illegal.newline.eldritch" }
                    },
                    "patterns": [
                        { "include": "#fstring-interpolation" },
                        { "include": "#string-escapes" }
                    ]
                },
                {
                    "name": "string.quoted.raw.double.eldritch",
                    "begin": "\\b([rR][bB]?|[bB][rR])(\")",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "(\")|($)",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.eldritch" },
                        "2": { "name": "invalid.illegal.newline.eldritch" }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.eldritch",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.raw.single.eldritch",
                    "begin": "\\b([rR][bB]?|[bB][rR])(')",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "(')|($)",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.eldritch" },
                        "2": { "name": "invalid.illegal.newline.eldritch" }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.eldritch",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.eldritch",
                    "begin": "(\\b[bB]?)(\")",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "(\")|($)",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.eldritch" },
                        "2": { "name": "invalid.illegal.newline.eldritch" }
                    },
                    "patterns": [
                        { "include": "#string-escapes" }
                    ]
                },
                {
                    "name": "string.quoted.single.eldritch",
                    "begin": "(\\b[bB]?)(')",
                    "beginCaptures": {
                        "1": { "name": "storage.type.string.eldritch" },
                        "2": { "name": "punctuation.definition.string.begin.eldritch" }
                    },
                    "end": "(')|($)",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.string.end.eldritch" },
                        "2": { "name": "invalid.illegal.newline.eldritch" }
                    },
                    "patterns": [
                        { "include": "#string-escapes" }
                    ]
                }
            ]
        },
        "string-escapes": {
            "patterns": [
                {
                    "name": "constant.character.escape.eldritch",
                    "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3}|[\\\\\"'abfnrtv0])"
                }
            ]
        },
        "fstring-interpolation": {
            "patterns": [
                {
                    "name": "constant.character.escape.eldritch",
                    "match": "\\{\\{|\\}\\}"
                },
                {
                    "name": "meta.embedded.line.eldritch",
                    "begin": "\\{",
                    "beginCaptures": {
                        "0": { "name": "punctuation.section.embedded.begin.eldritch" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.embedded.end.eldritch" }
                    },
                    "patterns": [
                        { "include": "$self" }
                    ]
                }
            ]
        },
        "function-def": {
            "patterns": [
                {
                    "name": "meta.function.eldritch",
                    "begin": "^\\s*(def)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
                    "beginCaptures": {
                        "1": { "name": "storage.type.function.eldritch" },
                        "2": { "name": "entity.name.function.eldritch" },
                        "3": { "name": "punctuation.definition.parameters.begin.eldritch" }
                    },
                    "end": "(\\))\\s*(?:(->)\\s*([^:]+?))?\\s*(:)",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.parameters.end.eldritch" },
                        "2": { "name": "punctuation.separator.annotation.result.eldritch" },
                        "3": { "name": "support.type.eldritch" },
                        "4": { "name": "punctuation.section.function.begin.eldritch" }
                    },
                    "patterns": [
                        { "include": "#comments" },
                        { "include": "#strings" },
                        { "include": "#constants" },
                        { "include": "#types" },
                        { "include": "#numbers" },
                        {
                            "name": "keyword.operator.unpacking.parameter.eldritch",
                            "match": "\\*\\*|\\*"
                        },
                        {
                            "name": "variable.parameter.function.language.eldritch",
                            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:[,:=)]|$))"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.flow.eldritch",
                    "match": "(?<!\\.)\\b(if|elif|else|for|in|return|break|continue|pass)\\b"
                },
                {
                    "name": "storage.type.function.eldritch",
                    "match": "(?<!\\.)\\b(def|lambda)\\b"
                },
                {
                    "name": "keyword.operator.logical.eldritch",
                    "match": "(?<!\\.)\\b(and|or|not|in|is)\\b"
                },
                {
                    "name": "invalid.illegal.keyword.eldritch",
                    "match": "(?<!\\.)\\b(while|class|try|except|finally|with|yield|async|await|import|from|global|nonlocal|raise|del|load)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.eldritch",
                    "match": "(?<!\\.)\\b(True|False)\\b"
                },
                {
                    "name": "constant.language.null.eldritch",
                    "match": "(?<!\\.)\\b(None)\\b"
                },
                {
                    "name": "variable.language.special.input_params.eldritch",
                    "match": "(?<!\\.)\\b(input_params)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.eldritch",
                    "match": "(?<!\\.)\\b(int|float|bool|str|bytes|Bytes|list|List|dict|Dict|tuple|Tuple|set|Set|Any|Optional|Union|Iterable|Callable|Value)\\b(?!\\s*\\()"
                }
            ]
        },
        "stdlib-calls": {
            "patterns": [
                {
                    "name": "meta.function-call.stdlib.deprecated.eldritch",
                    "match": "\\b(crypto|pivot)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "invalid.deprecated.module.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "invalid.deprecated.function.eldritch" }
                    }
                },
                {
                    "name": "meta.function-call.stdlib.deprecated.eldritch",
                    "match": "\\b(agent)\\s*(\\.)\\s*(get_callback_interval|get_config|get_transport)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "support.class.namespace.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "invalid.deprecated.function.eldritch" }
                    }
                },
                {
                    "name": "meta.function-call.stdlib.deprecated.eldritch",
                    "match": "\\b(assets)\\s*(\\.)\\s*(read_binary)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "support.class.namespace.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "invalid.deprecated.function.eldritch" }
                    }
                },
                {
                    "name": "meta.function-call.stdlib.deprecated.eldritch",
                    "match": "\\b(file)\\s*(\\.)\\s*(append_binary|compress|decompress|pwd|read_binary|temp_file|template|template_str|write_binary)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "support.class.namespace.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "invalid.deprecated.function.eldritch" }
                    }
                },
                {
                    "name": "meta.function-call.stdlib.deprecated.eldritch",
                    "match": "\\b(process)\\s*(\\.)\\s*(netstat)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "support.class.namespace.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "invalid.deprecated.function.eldritch" }
                    }
                },
                {
                    "name": "meta.function-call.stdlib.deprecated.eldritch",
                    "match": "\\b(sys)\\s*(\\.)\\s*(dll_inject|dll_reflect|get_env|get_ip|get_os|get_pid|get_reg|get_user|impersonate|list_users|tokens|use_token|whereis|write_reg)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "support.class.namespace.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "invalid.deprecated.function.eldritch" }
                    }
                },
                {
                    "name": "meta.function-call.stdlib.deprecated.eldritch",
                    "match": "\\b(time)\\s*(\\.)\\s*(format_to_epoch|format_to_readable)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "support.class.namespace.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "invalid.deprecated.function.eldritch" }
                    }
                },
                {
                    "name": "meta.function-call.stdlib.eldritch",
                    "match": "\\b(aes|agent|assets|base64|chain|dns|file|gzip|hash|http|json|linux|net|portal|process|random|regex|registry|report|scan|ssh|sys|template|time|user|windows)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "support.class.namespace.eldritch" },
                        "2": { "name": "punctuation.accessor.dot.eldritch" },
                        "3": { "name": "support.function.stdlib.eldritch" }
                    }
                }
            ]
        },
        "stdlib-modules": {
            "patterns": [
                {
                    "name": "support.class.namespace.eldritch",
                    "match": "(?<!\\.)\\b(aes|agent|assets|base64|chain|dns|file|gzip|hash|http|json|linux|net|portal|process|random|regex|registry|report|scan|ssh|sys|template|time|user|windows)\\b(?=\\s*\\.)"
                },
                {
                    "name": "invalid.deprecated.module.eldritch",
                    "match": "(?<!\\.)\\b(crypto|pivot)\\b(?=\\s*\\.)"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.eldritch",
                    "match": "(?<!\\.)\\b(abs|all|any|assert|assert_eq|bool|bytes|chr|dict|dir|divmod|enumerate|eprint|eval|fail|filter|float|getattr|hasattr|hash|hex|int|isinstance|len|list|map|max|min|oct|ord|pprint|print|range|repr|reversed|set|sorted|str|sum|tuple|type|zip)\\b(?=\\s*\\()"
                }
            ]
        },
        "method-calls": {
            "patterns": [
                {
                    "name": "meta.method-call.eldritch",
                    "match": "(\\.)\\s*(capitalize|casefold|center|count|encode|endswith|expandtabs|find|format|index|isalnum|isalpha|isascii|isdecimal|isdigit|isidentifier|islower|isnumeric|isprintable|isspace|istitle|isupper|join|ljust|lower|lstrip|partition|removeprefix|removesuffix|replace|rfind|rindex|rjust|rpartition|rsplit|rstrip|split|splitlines|startswith|strip|swapcase|title|upper|zfill|decode|fromhex|hex|append|clear|copy|extend|insert|pop|remove|reverse|sort|fromkeys|get|items|keys|popitem|setdefault|update|values|add|difference|difference_update|discard|intersection|intersection_update|isdisjoint|issubset|issuperset|symmetric_difference|symmetric_difference_update|union)\\b(?=\\s*\\()",
                    "captures": {
                        "1": { "name": "punctuation.accessor.dot.eldritch" },
                        "2": { "name": "support.function.method.eldritch" }
                    }
                }
            ]
        },
        "function-calls": {
            "patterns": [
                {
                    "name": "meta.function-call.eldritch",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.call.eldritch" }
                    }
                }
            ]
        },
        "keyword-arguments": {
            "patterns": [
                {
                    "name": "variable.parameter.function-call.eldritch",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?==(?!=))"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.eldritch",
                    "match": "\\b0[xX][0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.octal.eldritch",
                    "match": "\\b0[oO][0-7_]+\\b"
                },
                {
                    "name": "constant.numeric.binary.eldritch",
                    "match": "\\b0[bB][01_]+\\b"
                },
                {
                    "name": "constant.numeric.float.eldritch",
                    "match": "\\b[0-9][0-9_]*\\.[0-9_]+([eE][+-]?[0-9_]+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.eldritch",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "illegal-operators": {
            "patterns": [
                {
                    "name": "invalid.illegal.operator.eldritch",
                    "match": "&&|\\|\\||\\+\\+|--"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "punctuation.separator.annotation.result.eldritch",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.comparison.eldritch",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.augmented.eldritch",
                    "match": "\\+=|-=|\\*=|//=|/=|%=|&=|\\|=|\\^=|<<=|>>="
                },
                {
                    "name": "keyword.operator.assignment.eldritch",
                    "match": "=(?!=)"
                },
                {
                    "name": "keyword.operator.arithmetic.eldritch",
                    "match": "\\*\\*|//|\\+|-|\\*|/|%|@"
                },
                {
                    "name": "keyword.operator.bitwise.eldritch",
                    "match": "<<|>>|&|\\||\\^|~"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.colon.eldritch",
                    "match": ":"
                },
                {
                    "name": "punctuation.separator.comma.eldritch",
                    "match": ","
                },
                {
                    "name": "punctuation.accessor.dot.eldritch",
                    "match": "\\."
                }
            ]
        }
    }
}